---
const currentYear = new Date().getFullYear();

interface FooterLink {
  href: string;
  label: string;
}

const quickLinks: FooterLink[] = [
  { href: '/about', label: 'About' },
  { href: '/crew', label: 'Crew' },
  { href: '/events', label: 'Events' },
  { href: '/join', label: 'Join' },
  { href: '/join#contact', label: 'Contact' },
];
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Column 1: Brand & Tagline -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <svg
            class="footer-logo-svg"
            viewBox="0 0 32 32"
            width="32"
            height="32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M16 3C8.82 3 3 8.82 3 16C3 23.18 8.82 29 16 29C17.8 29 19.5 28.62 21.05 27.95C16.28 26.57 12.8 22.18 12.8 17C12.8 11.82 16.28 7.43 21.05 6.05C19.5 5.38 17.8 3 16 3Z"
              fill="url(#footer-crescent)"
            />
            <path
              d="M23 11L24 14.5L27.5 15.5L24 16.5L23 20L22 16.5L18.5 15.5L22 14.5L23 11Z"
              fill="var(--star)"
            />
            <defs>
              <linearGradient id="footer-crescent" x1="3" y1="3" x2="24" y2="29" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="var(--star)" />
                <stop offset="60%" stop-color="var(--orbit)" />
                <stop offset="100%" stop-color="var(--deep)" />
              </linearGradient>
            </defs>
          </svg>
          <span class="footer-title">Callisto Club</span>
        </div>
        <p class="footer-tagline">
          The student expeditionary astronomy club of Chennai Institute of Technology. Exploring the cosmos, advancing observational astrophysics, and inspiring celestial explorers.
        </p>
        <div class="footer-telemetry" aria-label="Observatory status">
          <span class="pulse-indicator"></span>
          <span>CIT OBSERVATORY &bull; ORBITAL EXPEDITION</span>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-col links-col">
        <h3 class="footer-heading">Navigation</h3>
        <ul class="footer-links-list">
          {
            quickLinks.map((item) => (
              <li>
                <a href={item.href} class="footer-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Telemetry & Social Links -->
      <div class="footer-col social-col">
        <h3 class="footer-heading">Transmissions</h3>
        <p class="social-description">
          Tune into orbital dispatches, observation schedules, and deep-sky imagery.
        </p>
        <ul class="social-list">
          <li>
            <a
              href="https://instagram.com/callistospace_cit"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Callisto Club on Instagram"
            >
              <svg
                class="social-icon"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>@callistospace_cit</span>
            </a>
          </li>
          <li>
            <a
              href="mailto:callistospace.cit@gmail.com"
              class="social-link"
              aria-label="Email Callisto Club"
            >
              <svg
                class="social-icon"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>callistospace.cit@gmail.com</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Callisto Club. All systems nominal.
      </p>

      <button
        type="button"
        id="back-to-top-btn"
        class="back-to-top-btn"
        aria-label="Scroll back to top of the page"
      >
        <span>Back to top</span>
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--deep);
    padding: var(--space-2xl) 0 var(--space-xl) 0;
    margin-top: auto;
    width: 100%;
  }

  /* Thin gradient border-top from --navy to --orbit */
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--navy) 20%, var(--orbit) 50%, var(--navy) 80%, transparent 100%);
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-md);
  }

  .footer-logo-svg {
    width: 32px;
    height: 32px;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--orbit) 40%, transparent));
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--moon);
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--steel);
    margin: 0 0 var(--space-md) 0;
    max-width: 38ch;
  }

  .footer-telemetry {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--orbit);
    padding: 0.25rem 0.5rem;
    background: color-mix(in srgb, var(--navy) 40%, transparent);
    border: 1px solid color-mix(in srgb, var(--orbit) 25%, transparent);
    border-radius: var(--radius-sm);
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--astrophage);
    box-shadow: 0 0 6px var(--astrophage);
    animation: beaconPulse 2s infinite ease-in-out;
  }

  @keyframes beaconPulse {
    0%, 100% {
      opacity: 0.4;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--moon);
    margin: 0 0 var(--space-md) 0;
  }

  .footer-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--star);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--moon);
    transform: translateX(3px);
  }

  .social-description {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--steel);
    margin: 0 0 var(--space-md) 0;
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--star);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-icon {
    color: var(--orbit);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--moon);
  }

  .social-link:hover .social-icon,
  .social-link:focus-visible .social-icon {
    color: var(--astrophage);
    transform: scale(1.15);
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--steel) 15%, transparent);
  }

  .copyright {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--steel);
    margin: 0;
    text-align: center;
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: color-mix(in srgb, var(--navy) 40%, transparent);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-sm);
    color: var(--star);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .back-to-top-btn:hover,
  .back-to-top-btn:focus-visible {
    color: var(--moon);
    border-color: var(--orbit);
    background: color-mix(in srgb, var(--navy) 80%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--orbit) 25%, transparent);
    outline: none;
  }

  .back-to-top-btn svg {
    transition: transform 0.2s ease;
  }

  .back-to-top-btn:hover svg {
    transform: translateY(-2px);
  }

  /* Desktop 3 Columns Layout */
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: var(--space-2xl);
    }

    .footer-bottom {
      flex-direction: row;
    }

    .copyright {
      text-align: left;
    }
  }

  /* Focus outline management */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--orbit);
    outline-offset: 2px;
  }
</style>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn');
    if (!btn) return;

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
