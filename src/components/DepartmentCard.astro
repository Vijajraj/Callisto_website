interface Props {
  id: string;
  name: string;
  themedName: string;
  lead: string;
  role?: string;
  shipModule?: string;
  description?: string;
  icon: string;
}

const { id, name, themedName, lead, role = '', shipModule = '', description = '', icon } = Astro.props;
---

<a href={`/crew/${id}`} class="dept-card" aria-label={`View department: ${themedName} (${name})`}>
  <div class="dept-card-header">
    {shipModule ? <span class="ship-module">{shipModule}</span> : <span class="ship-module-empty"></span>}
    <span class="dept-icon" aria-hidden="true">
      {icon && (icon.startsWith('/') || icon.includes('.')) ? (
        <img src={icon} alt="" width="32" height="32" class="dept-icon-img" />
      ) : (
        icon
      )}
    </span>
  </div>

  <div class="dept-card-body">
    <h3 class="dept-themed-name">{themedName}</h3>
    <span class="dept-real-name">{name}</span>

    {description ? (
      <p class="dept-description">{description}</p>
    ) : (
      <div class="dept-blank-slot" aria-hidden="true"></div>
    )}
  </div>

  <div class="dept-card-footer">
    <div class="dept-lead">
      <span class="lead-name">{lead}</span>
      {role && (
        <span class="lead-role-tag">{role}</span>
      )}
    </div>

    <div class="dept-arrow" aria-hidden="true">
      <svg
        viewBox="0 0 20 20"
        width="16"
        height="16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
          clip-rule="evenodd"
        ></path>
      </svg>
    </div>
  </div>
</a>

<style>
  .dept-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
  }

  /* Cosmic corner highlight accent */
  .dept-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60px;
    height: 60px;
    background: radial-gradient(circle at top right, color-mix(in srgb, var(--orbit) 25%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .dept-card:hover,
  .dept-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--orbit);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--orbit) 25%, transparent);
    background-color: color-mix(in srgb, var(--navy) 40%, var(--deep));
    outline: none;
  }

  .dept-card:hover::before,
  .dept-card:focus-visible::before {
    opacity: 1;
  }

  .dept-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-md);
  }

  .ship-module {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
    padding: 0.2rem 0.5rem;
    background: color-mix(in srgb, var(--void) 50%, transparent);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-sm);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .dept-card:hover .ship-module {
    color: var(--star);
    border-color: color-mix(in srgb, var(--orbit) 40%, transparent);
  }

  .dept-icon {
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--navy) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .dept-card:hover .dept-icon {
    transform: scale(1.1);
    border-color: var(--orbit);
  }

  .dept-icon-img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--orbit) 45%, transparent));
  }

  .dept-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-lg);
  }

  .dept-themed-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--moon);
    margin: 0 0 0.25rem 0;
    transition: color 0.2s ease;
  }

  .dept-card:hover .dept-themed-name {
    color: var(--star);
  }

  .dept-real-name {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--orbit);
    margin-bottom: var(--space-sm);
  }

  .dept-description {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--steel);
    margin: 0;
  }

  .dept-blank-slot {
    min-height: 2.2rem;
  }

  .dept-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-sm);
    border-top: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
    gap: 0.5rem;
  }

  .dept-lead {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .lead-prefix {
    color: var(--steel);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .lead-name {
    color: var(--astrophage);
    font-weight: 600;
  }

  .lead-role-tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--star);
    background: rgba(156, 132, 214, 0.15);
    border: 1px solid rgba(156, 132, 214, 0.3);
    border-radius: var(--radius-sm);
    padding: 0.12rem 0.45rem;
    margin-top: 0.15rem;
  }

  .dept-arrow {
    color: var(--steel);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .dept-card:hover .dept-arrow {
    color: var(--orbit);
    transform: translateX(4px);
  }

  /* Accessibility focus ring */
  .dept-card:focus-visible {
    outline: 2px solid var(--orbit);
    outline-offset: 3px;
  }
</style>
