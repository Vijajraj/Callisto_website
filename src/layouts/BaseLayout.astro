---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SoundHud from '../components/react/SoundHud';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Join the Callisto Expedition — a student astronomy club exploring the cosmos.',
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://callisto.pages.dev');
const pageTitle = title.includes('Callisto') ? title : `Callisto | ${title}`;
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site ?? 'https://callisto.pages.dev').toString()
  : new URL('/logo.jpg', Astro.site ?? 'https://callisto.pages.dev').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Callisto Astronomy Club" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="theme-color" content="#0B0507" />
    <meta name="generator" content={Astro.generator} />

    <!-- Astro 5 Client Router for seamless persistent page transitions -->
    <ClientRouter />

    <!-- Prevent flash of unstyled theme / Space Theme preference script -->
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var savedTheme = localStorage.getItem('callisto-theme');
            var isSolar = savedTheme === 'solar-flare' || savedTheme === 'light';
            if (isSolar) {
              document.documentElement.classList.add('theme-solar-flare');
              document.documentElement.classList.add('light-mode');
              document.documentElement.classList.remove('theme-deep-space');
              document.documentElement.setAttribute('data-theme', 'solar-flare');
            } else {
              document.documentElement.classList.add('theme-deep-space');
              document.documentElement.classList.remove('theme-solar-flare');
              document.documentElement.classList.remove('light-mode');
              document.documentElement.setAttribute('data-theme', 'deep-space');
            }
          } catch (e) {
            /* LocalStorage fallback */
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <!-- Accessible Skip to Main Content Link -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <Navigation />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <SoundHud client:load transition:persist />
  </body>
</html>

<style>
  html {
    background-color: var(--void);
    color: var(--moon);
    color-scheme: dark;
    scroll-behavior: smooth;
    box-sizing: border-box;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    background-color: var(--void);
    color: var(--moon);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    position: relative;
    padding-top: 64px; /* Account for fixed top navigation */
  }

  main:focus {
    outline: none;
  }

  /* Accessible Skip-to-Content Link */
  .skip-to-content {
    position: absolute;
    top: -100px;
    left: var(--space-md);
    z-index: 9999;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--navy);
    color: var(--moon);
    border: 1px solid var(--orbit);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 0 24px color-mix(in srgb, var(--orbit) 50%, transparent);
    transition: top 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .skip-to-content:focus {
    top: var(--space-md);
    outline: 2px solid var(--star);
    outline-offset: 2px;
  }
</style>
