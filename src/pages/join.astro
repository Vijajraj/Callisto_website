import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JoinForm from '../components/react/JoinForm';
import { departments } from '../data/departments';

const departmentOptions = departments.map((d) => `${d.themedName} (${d.name})`);

const benefits = [
  {
    icon: '/icons/dept-astronomy.png',
    title: 'Telescope Array Access',
    desc: 'Hands-on training and dark-sky field sessions operating motorized computerized Schmidt-Cassegrain optical setups and narrowband filters.',
  },
  {
    icon: '/icons/dept-tech.png',
    title: 'Research & Data Science',
    desc: 'Collaborate on exoplanet transit detection, orbital mechanics simulators, and machine-learning reduction of photometric datasets.',
  },
  {
    icon: '/icons/dept-event.png',
    title: 'Flagship Expeditions',
    desc: 'Priority passes to dark-sky camping expeditions, national space hackathons, and guest symposiums with leading astrophysicists.',
  },
  {
    icon: '/icons/dept-general.png',
    title: 'Cross-Disciplinary Wings',
    desc: 'Gain real-world leadership across 11 ship modules spanning engineering, visual design, science journalism, and international relations.',
  },
];

const faqs = [
  {
    question: 'Do I need prior astronomy or astrophysics experience?',
    answer:
      'Not at all. We believe the wonder of space belongs to everyone. Whether you are a total beginner who just bought your first pair of binoculars or an advanced physics researcher, our onboarding paths are engineered to teach and inspire.',
  },
  {
    question: 'How much time commitment is expected per week?',
    answer:
      'General members typically commit 2 to 3 hours per week attending observation sessions, weekend workshops, and general body meetups. Core departmental project leads generally dedicate 4 to 6 hours during major launch cycles.',
  },
  {
    question: 'Can I participate across multiple ship departments?',
    answer:
      'Yes! Many crew members cross-specialize—for instance, designing astrophotography posters in Nebula Wing while operating the scopes with the LUNAR Society. You will select a primary home module and can collaborate across wings freely.',
  },
  {
    question: 'Who can apply to join Callisto?',
    answer:
      'Any currently enrolled student across all academic departments, engineering disciplines, and degree years at Chennai Institute of Technology is eligible to board.',
  },
];
---

<BaseLayout
  title="Join the Expedition | Callisto Club"
  description="Board Callisto Club. Submit your boarding application to join our 11 interdisciplinary space wings, dark-sky expeditions, and research cohorts."
>
  <div class="join-page-container">
    <!-- Header -->
    <header class="join-header">
      <SectionHeading
        mono="BOARDING APPLICATION"
        title="Join the Expedition"
        subtitle="Every great mission needs exceptional crew members. Whether you're a seasoned stargazer or just beginning to look up, there's a place for you aboard."
        align="center"
      />
    </header>

    <!-- What to Expect / Membership Benefits -->
    <section class="benefits-section" aria-labelledby="benefits-heading">
      <div class="section-badge-center">MISSION ADVANTAGES</div>
      <h2 id="benefits-heading" class="benefits-title">What Awaits You Aboard</h2>

      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card">
            <div class="benefit-icon" aria-hidden="true">
              {b.icon.startsWith('/') ? (
                <img src={b.icon} alt="" width="38" height="38" style="object-fit: contain;" />
              ) : (
                b.icon
              )}
            </div>
            <h3 class="benefit-heading">{b.title}</h3>
            <p class="benefit-desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Application Form Section -->
    <section id="application-form" class="form-section" aria-labelledby="form-heading">
      <div class="form-panel">
        <div class="form-header">
          <span class="manifest-tag">CADET MANIFEST ENROLLMENT</span>
          <h2 id="form-heading" class="form-title">Flight Crew Application</h2>
          <p class="form-subtitle">
            Fill in your telemetry details below. Applications are reviewed by executive commanders on a rolling basis.
          </p>
        </div>

        <JoinForm client:visible departments={departmentOptions} />
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section" aria-labelledby="faq-heading">
      <SectionHeading
        mono="FREQUENTLY ASKED QUESTIONS"
        title="Clarifications & Protocols"
        subtitle="Common questions from prospective recruits preparing to embark with Callisto."
        align="center"
      />

      <div class="faq-accordion-list">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-summary">
              <span class="faq-question">{faq.question}</span>
              <svg class="faq-chevron" viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .join-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .join-page-container {
      padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    }
  }

  .join-header {
    margin-bottom: var(--space-2xl);
  }

  /* Benefits */
  .benefits-section {
    margin-bottom: var(--space-3xl);
    text-align: center;
  }

  .section-badge-center {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--astrophage);
    background: color-mix(in srgb, var(--astrophage) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--astrophage) 35%, transparent);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-xs);
  }

  .benefits-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xl) 0;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    text-align: left;
  }

  @media (min-width: 640px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .benefits-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .benefit-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .benefit-card:hover {
    transform: translateY(-4px);
    border-color: var(--orbit);
  }

  .benefit-icon {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
    line-height: 1;
  }

  .benefit-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .benefit-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--steel);
    margin: 0;
  }

  /* Form Section */
  .form-section {
    margin-bottom: var(--space-3xl);
  }

  .form-panel {
    background: linear-gradient(155deg, color-mix(in srgb, var(--navy) 60%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-lg);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--void) 85%, transparent);
  }

  @media (min-width: 768px) {
    .form-panel {
      padding: var(--space-3xl);
    }
  }

  .form-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-2xl) auto;
  }

  .manifest-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--orbit);
    display: inline-block;
    margin-bottom: var(--space-xs);
  }

  .form-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .form-subtitle {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--star);
    margin: 0;
  }

  /* FAQ */
  .faq-section {
    margin-bottom: var(--space-2xl);
  }

  .faq-accordion-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .faq-item {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .faq-item[open] {
    border-color: var(--orbit);
    background-color: color-mix(in srgb, var(--navy) 40%, var(--deep));
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--moon);
  }

  .faq-chevron {
    color: var(--orbit);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-lg) var(--space-md);
  }

  .faq-answer p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--star);
    margin: 0;
  }
</style>
