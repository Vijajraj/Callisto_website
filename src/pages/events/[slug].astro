 * GitHub Profile: https://github.com/Vijajraj
 * Repository: https://github.com/Vijajraj/Callisto_website
 * =====================================================================
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCountdown from '../../components/react/EventCountdown';
import { events, type CallistoEvent } from '../../data/events';
import { formatDate } from '../../lib/utils';

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: CallistoEvent;
}

const { event } = Astro.props;

const isUpcoming = event.registrationOpen || new Date(event.date).getTime() >= Date.now();
const formattedDate = formatDate(event.date, {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const formatTime = (isoString: string): string => {
  try {
    return new Date(isoString).toLocaleTimeString('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short',
    });
  } catch {
    return '18:00 UTC';
  }
};

const startTimeStr = formatTime(event.date);
const endTimeStr = event.endDate ? formatTime(event.endDate) : null;
---

<BaseLayout
  title={`${event.title} | Callisto Mission Events`}
  description={`Event Dossier: ${event.title} — scheduled for ${formattedDate} at ${event.location}.`}
>
  <div class="event-detail-container">
    <!-- Back to Events Link -->
    <nav class="back-nav" aria-label="Breadcrumb navigation">
      <a href="/events" class="back-link">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        <span>Back to Launch Schedule</span>
      </a>
    </nav>

    <!-- Event Header -->
    <header class="event-header">
      <div class="header-badges">
        <span class="type-badge">{event.type}</span>
        <span class:list={['status-badge', event.registrationOpen ? 'status-open' : 'status-closed']}>
          {event.registrationOpen ? 'Registration Active' : 'Mission Concluded'}
        </span>
      </div>

      <h1 class="event-title">{event.title}</h1>

      <div class="meta-telemetry-grid">
        <div class="meta-tile">
          <span class="meta-label">EXPEDITION DATE</span>
          <span class="meta-val">{formattedDate}</span>
        </div>

        <div class="meta-tile">
          <span class="meta-label">TIMING WINDOW</span>
          <span class="meta-val">{startTimeStr} {endTimeStr ? `– ${endTimeStr}` : ''}</span>
        </div>

        <div class="meta-tile">
          <span class="meta-label">TARGET LOCATION</span>
          <span class="meta-val">{event.location}</span>
        </div>

        {event.capacity && (
          <div class="meta-tile">
            <span class="meta-label">CREW CAPACITY</span>
            <span class="meta-val">{event.capacity} Explorers</span>
          </div>
        )}
      </div>
    </header>

    <!-- Main Content Layout -->
    <div class="event-layout-grid">
      <!-- Left Column: Dossier, Full Description, Speakers -->
      <main class="event-main-col">
        <section class="section-card" aria-labelledby="overview-heading">
          <h2 id="overview-heading" class="card-heading">Mission Dossier</h2>
          <div class="prose">
            <p class="lead-text">{event.description}</p>
            <p>{event.longDescription}</p>
          </div>
        </section>

        <!-- Speakers List (if any) -->
        {event.speakers && event.speakers.length > 0 && (
          <section class="section-card" aria-labelledby="speakers-heading">
            <h2 id="speakers-heading" class="card-heading">Mission Leads & Speakers</h2>
            <div class="speakers-list">
              {event.speakers.map((speaker) => (
                <div class="speaker-card">
                  <div class="speaker-avatar" aria-hidden="true">
                    <img src="/icons/dept-people.png" alt="" width="30" height="30" style="object-fit: contain;" />
                  </div>
                  <div class="speaker-info">
                    <span class="speaker-name">{speaker}</span>
                    <span class="speaker-role">Featured Flight Instructor</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </main>

      <!-- Right Column: Registration / Countdown Action Panel -->
      <aside class="event-aside-col" aria-label="Mission Registration and Telemetry">
        {isUpcoming ? (
          <div class="action-card">
            <div class="action-card-header">
              <span class="action-tag">COUNTDOWN TO DEPLOYMENT</span>
            </div>

            <div class="countdown-embed">
              <EventCountdown
                client:visible
                targetDate={event.date}
                eventTitle={event.title}
              />
            </div>

            <div class="action-buttons-wrap">
              {event.registrationOpen ? (
                <a href="/join" class="btn-primary full-width">
                  <span>Register for Expedition</span>
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </a>
              ) : (
                <div class="registration-closed-notice">
                  <span>Boarding Manifest Full</span>
                  <p>Follow our comms relays for waitlist openings.</p>
                </div>
              )}
            </div>

            <div class="telemetry-info-box">
              <div class="telemetry-bullet">
                <span class="bullet-dot"></span>
                <span>Coordinates transmitted 24h prior to launch</span>
              </div>
              <div class="telemetry-bullet">
                <span class="bullet-dot"></span>
                <span>Red-light optical protocol strictly enforced</span>
              </div>
            </div>
          </div>
        ) : (
          <div class="action-card past-card">
            <div class="action-tag">MISSION CONCLUDED</div>
            <p class="past-text">
              This expedition has concluded its primary flight window. Telemetry, observation logs, and astrophotography captures are being archived in the observatory logs.
            </p>
            <a href="/events" class="btn-outline full-width">
              <span>View Upcoming Schedule &rarr;</span>
            </a>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .event-detail-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .event-detail-container {
      padding: var(--space-2xl) var(--space-xl) var(--space-3xl);
    }
  }

  /* Back Navigation */
  .back-nav {
    margin-bottom: var(--space-xl);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--steel);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--orbit);
    transform: translateX(-4px);
  }

  /* Header */
  .event-header {
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
    padding-bottom: var(--space-2xl);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .type-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orbit);
    background: color-mix(in srgb, var(--orbit) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .status-open {
    color: #4ade80;
    background: color-mix(in srgb, #22c55e 15%, transparent);
    border: 1px solid color-mix(in srgb, #22c55e 35%, transparent);
  }

  .status-closed {
    color: var(--steel);
    background: color-mix(in srgb, var(--void) 50%, transparent);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
  }

  .event-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--moon);
    margin: 0 0 var(--space-xl) 0;
  }

  .meta-telemetry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .meta-telemetry-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .meta-telemetry-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .meta-tile {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--steel);
    letter-spacing: 0.1em;
  }

  .meta-val {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--star);
  }

  /* Two Column Grid */
  .event-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .event-layout-grid {
      grid-template-columns: 1.7fr 1.1fr;
      align-items: start;
    }
  }

  .section-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .card-heading {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-md) 0;
  }

  .lead-text {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--moon);
    margin-bottom: var(--space-md);
  }

  .prose p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--star);
    margin-bottom: var(--space-md);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  /* Speakers */
  .speakers-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .speaker-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background-color: color-mix(in srgb, var(--navy) 40%, transparent);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-sm);
  }

  .speaker-avatar {
    font-size: 1.75rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: color-mix(in srgb, var(--navy) 80%, transparent);
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--orbit) 30%, transparent);
  }

  .speaker-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .speaker-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--moon);
  }

  .speaker-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--astrophage);
  }

  /* Action Card Sidebar */
  .action-card {
    background-color: color-mix(in srgb, var(--navy) 50%, var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    box-shadow: 0 10px 32px color-mix(in srgb, var(--void) 80%, transparent);
  }

  .action-card-header {
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .action-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--astrophage);
    display: inline-block;
  }

  .countdown-embed {
    margin-bottom: var(--space-xl);
  }

  .action-buttons-wrap {
    margin-bottom: var(--space-xl);
  }

  .full-width {
    width: 100%;
    box-sizing: border-box;
  }

  .registration-closed-notice {
    padding: var(--space-md);
    background-color: color-mix(in srgb, var(--void) 60%, transparent);
    border: 1px dashed var(--steel);
    border-radius: var(--radius-sm);
    text-align: center;
    font-family: var(--font-mono);
  }

  .registration-closed-notice span {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--moon);
    margin-bottom: 0.25rem;
  }

  .registration-closed-notice p {
    font-size: 0.75rem;
    color: var(--steel);
    margin: 0;
  }

  .telemetry-info-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-top: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
    padding-top: var(--space-md);
  }

  .telemetry-bullet {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--steel);
    line-height: 1.4;
  }

  .bullet-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--orbit);
    margin-top: 0.35rem;
    flex-shrink: 0;
  }

  .past-card {
    text-align: center;
  }

  .past-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--steel);
    margin: var(--space-md) 0 var(--space-xl) 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    background: linear-gradient(135deg, var(--orbit), var(--dusk));
    color: var(--moon);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--orbit) 50%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--orbit) 35%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0 28px color-mix(in srgb, var(--orbit) 60%, transparent);
    color: #ffffff;
    outline: none;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: color-mix(in srgb, var(--navy) 40%, transparent);
    color: var(--star);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--steel) 40%, transparent);
    transition: all 0.2s ease;
  }

  .btn-outline:hover,
  .btn-outline:focus-visible {
    color: var(--moon);
    border-color: var(--orbit);
    background: color-mix(in srgb, var(--navy) 80%, transparent);
    outline: none;
  }
</style>
