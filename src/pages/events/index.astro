---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCountdown from '../../components/react/EventCountdown';
import EventExplorer from '../../components/react/EventExplorer';
import { events, getUpcomingEvents } from '../../data/events';

const upcomingEvents = getUpcomingEvents();
const nextUpcoming = upcomingEvents.length > 0 ? upcomingEvents[0] : null;
---

<BaseLayout
  title="Mission Launches & Celestial Events | Callisto Club"
  description="Explore upcoming observational expeditions, exoplanet hackathons, and guest astrophysics symposiums hosted by Callisto Club."
>
  <div class="events-page-container">
    <!-- Header -->
    <header class="events-header">
      <SectionHeading
        mono="LAUNCH SCHEDULE"
        title="Events & Expeditions"
        subtitle="From all-night dark sky star parties to 36-hour data science sprints, explore our mission logs with real-time telemetry filters."
        align="center"
      />
    </header>

    <!-- Prominent Next Event Countdown -->
    {nextUpcoming && (
      <section class="featured-countdown-section" aria-label="Next Scheduled Launch">
        <div class="featured-countdown-wrapper">
          <div class="featured-badge">COUNTDOWN TO NEXT EXPEDITION</div>
          <EventCountdown
            client:visible
            targetDate={nextUpcoming.date}
            eventTitle={nextUpcoming.title}
          />
        </div>
      </section>
    )}

    <!-- Interactive Event Explorer Island -->
    <section class="events-explorer-section" aria-label="Interactive Expedition Event Browser">
      <EventExplorer client:load initialEvents={events} />
    </section>

    <!-- Suggest Event CTA -->
    <section class="suggest-cta-section" aria-label="Suggest an Event">
      <div class="suggest-card">
        <div class="suggest-icon" aria-hidden="true">✨</div>
        <h3 class="suggest-title">Have an Event or Mission Idea?</h3>
        <p class="suggest-desc">
          Do you want to host a stargazing night in your department, suggest a guest lecturer, or organize a space hardware workshop? Coordinate with our Event Horizon operations crew.
        </p>
        <a href="/contact" class="btn-outline">
          <span>Suggest a Mission &rarr;</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .events-page-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .events-page-container {
      padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    }
  }

  .events-header {
    margin-bottom: var(--space-2xl);
  }

  /* Featured Countdown */
  .featured-countdown-section {
    margin-bottom: var(--space-3xl);
  }

  .featured-countdown-wrapper {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .featured-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--astrophage);
    background: color-mix(in srgb, var(--astrophage) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--astrophage) 35%, transparent);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }

  /* Explorer Section */
  .events-explorer-section {
    margin-bottom: var(--space-3xl);
  }

  /* Suggest CTA */
  .suggest-cta-section {
    margin-top: var(--space-2xl);
  }

  .suggest-card {
    background: linear-gradient(135deg, color-mix(in srgb, var(--navy) 60%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .suggest-icon {
    font-size: 2.25rem;
    margin-bottom: var(--space-sm);
  }

  .suggest-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .suggest-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--star);
    max-width: 580px;
    margin: 0 0 var(--space-lg) 0;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: color-mix(in srgb, var(--navy) 50%, transparent);
    color: var(--moon);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--orbit) 50%, transparent);
    transition: all 0.2s ease;
  }

  .btn-outline:hover,
  .btn-outline:focus-visible {
    transform: translateY(-2px);
    border-color: var(--star);
    background: color-mix(in srgb, var(--navy) 80%, transparent);
    box-shadow: 0 0 16px color-mix(in srgb, var(--orbit) 35%, transparent);
    outline: none;
  }
</style>
