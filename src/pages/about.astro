import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JovianOrrery from '../components/react/JovianOrrery';
---

<BaseLayout title="About Callisto | Mission Briefing" description="The story, identity, and celestial charter of Callisto Club — Chennai Institute of Technology's astronomy & space club.">
  <div class="about-container">
    <!-- Page Hero -->
    <header class="about-hero">
      <SectionHeading
        mono="MISSION BRIEFING"
        title="About Callisto"
        subtitle=""
        align="center"
      />
    </header>

    <!-- Origin Story Section -->
    <section class="story-section" aria-labelledby="origin-heading">
      <div class="story-card">
        <div class="story-badge">ORIGIN DOSSIER</div>
        <h2 id="origin-heading" class="story-title">Why Callisto?</h2>
        
        <div class="story-prose">
          <p>
            Orbiting nearly two million kilometers from the turbulent cloud bands of Jupiter lies Callisto. Discovered in 1610 by Galileo Galilei, this celestial body bears the most heavily cratered surface in our solar system—an ancient, untouched ledger recording four billion years of cosmic impacts. Beneath its dark, scarred crust of rock and ice lies a quiet, saline subsurface ocean.
          </p>
          <p>
            Unlike its radiation-seared sibling Europa or volcanic Io, Callisto rests in a calm magnetospheric harbor. For generations of planetary scientists and visionary engineers, it represents the ideal deep-space outpost: an anchor from which humanity can safely observe the outer solar system and gaze deeper into deep cosmic space.
          </p>
          <div class="blank-slot" aria-label="Club story details to be added in future">
            <!-- Blank slot kept for user future story details -->
          </div>
        </div>
      </div>

      <div class="orrery-wrapper">
        <JovianOrrery client:visible />
      </div>
    </section>

    <!-- What We Do Section -->
    <section class="activities-section" aria-labelledby="activities-heading">
      <SectionHeading
        mono="FLIGHT PROGRAM"
        title="What We Do"
        subtitle=""
        align="center"
      />

      <div class="activities-blank-container" aria-label="Activities section kept blank for user future content">
        <!-- Blank slots kept for user future activities -->
      </div>
    </section>

    <!-- Vision Statement Quote -->
    <section class="vision-section" aria-label="Our Vision">
      <div class="vision-card">
        <blockquote class="vision-quote vision-blank" aria-label="Vision quote kept blank for future input">
          <!-- Blank slot kept for future club charter or vision statement -->
        </blockquote>
      </div>
    </section>

    <!-- By The Numbers Section -->
    <section class="stats-section" aria-labelledby="telemetry-heading">
      <div class="stats-blank-grid" aria-label="Telemetry slots kept blank for user future statistics">
        <!-- Blank slots kept for user future statistics -->
      </div>
    </section>

    <!-- Faculty Coordinator Section -->
    <section class="faculty-section" aria-labelledby="faculty-heading">
      <div class="faculty-card">
        <div class="faculty-badge">INSTITUTIONAL OVERSIGHT</div>
        <h3 id="faculty-heading" class="faculty-name">Faculty Coordinator</h3>
        <p class="faculty-status">Official Institutional Appointment To Be Announced</p>
        <div class="blank-slot" aria-label="Faculty details to be added in future">
          <!-- Blank slot kept for user future faculty info -->
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .about-container {
      padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    }
  }

  .about-hero {
    margin-bottom: var(--space-2xl);
  }

  /* Origin Story Section */
  .story-section {
    margin-bottom: var(--space-3xl);
  }

  .orrery-wrapper {
    margin-top: var(--space-2xl);
  }

  .story-card {
    background: linear-gradient(145deg, color-mix(in srgb, var(--navy) 60%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    position: relative;
    box-shadow: 0 12px 32px color-mix(in srgb, var(--void) 70%, transparent);
  }

  @media (min-width: 768px) {
    .story-card {
      padding: var(--space-2xl) var(--space-3xl);
    }
  }

  .story-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--sol-dust);
    background: color-mix(in srgb, var(--sol-dust) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--sol-dust) 35%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }

  .story-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--moon);
    margin: 0 0 var(--space-lg) 0;
  }

  .story-prose p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--star);
    margin-bottom: var(--space-md);
  }

  /* Blank slots kept for user future information */
  .blank-slot {
    min-height: 4rem;
    border: 1px dashed color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--void) 30%, transparent);
    margin-top: var(--space-md);
  }

  .activities-blank-container {
    min-height: 6rem;
    border: 1px dashed color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--deep) 50%, transparent);
    margin-top: var(--space-xl);
  }

  .activities-section {
    margin-bottom: var(--space-3xl);
  }

  /* Vision Quote */
  .vision-section {
    margin-bottom: var(--space-3xl);
  }

  .vision-card {
    background: linear-gradient(135deg, color-mix(in srgb, var(--navy) 40%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
  }

  .vision-blank {
    min-height: 3rem;
  }

  /* Stats Section */
  .stats-section {
    margin-bottom: var(--space-3xl);
  }

  .stats-blank-grid {
    min-height: 5rem;
    border: 1px dashed color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--deep) 50%, transparent);
  }

  /* Faculty Section */
  .faculty-section {
    margin-bottom: var(--space-xl);
  }

  .faculty-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
  }

  .faculty-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--orbit);
    background: color-mix(in srgb, var(--orbit) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }

  .faculty-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .faculty-status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--astrophage);
    margin: 0 0 var(--space-md) 0;
  }
</style>
