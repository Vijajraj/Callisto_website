import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import DepartmentCard from '../../components/DepartmentCard.astro';
import { departments } from '../../data/departments';
---

<BaseLayout title="Crew Manifest | Callisto Club" description="Meet the 11 specialized ship wings and operational modules driving the Callisto Expedition.">
  <div class="crew-page-container">
    <!-- Header -->
    <header class="crew-header">
      <SectionHeading
        mono="SHIP MANIFEST"
        title="The Crew"
        subtitle="Every department is a module on the ship. Find your station."
        align="center"
      />
    </header>

    <!-- Departments Grid -->
    <section class="departments-grid-section" aria-label="Ship Modules and Department Stations">
      <div class="crew-grid">
        {departments.map((dept) => (
          <DepartmentCard
            id={dept.id}
            name={dept.name}
            themedName={dept.themedName}
            lead={dept.lead}
            role={dept.role}
            shipModule={dept.shipModule}
            description={dept.description}
            icon={dept.icon}
          />
        ))}
      </div>
    </section>

    <!-- Join CTA Footer -->
    <section class="crew-cta-section" aria-label="Join a Department">
      <div class="cta-panel">
        <div class="cta-telemetry">VACANCIES ACROSS MULTIPLE FLIGHT WINGS</div>
        <h2 class="cta-heading">Ready to Take Your Station?</h2>
        <p class="cta-desc">
          Whether you want to command the telescope bay, analyze exoplanetary datasets, or direct our visual communications, there is an open flight console waiting for you.
        </p>
        <a href="/join" class="btn-primary">
          <span>Apply to Join the Crew</span>
          <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .crew-page-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .crew-page-container {
      padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    }
  }

  .crew-header {
    margin-bottom: var(--space-2xl);
  }

  /* 3 cols desktop, 2 tablet, 1 mobile */
  .crew-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-3xl);
  }

  @media (min-width: 640px) {
    .crew-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .crew-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Join CTA Panel */
  .crew-cta-section {
    margin-top: var(--space-xl);
  }

  .cta-panel {
    background: linear-gradient(145deg, color-mix(in srgb, var(--navy) 70%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    box-shadow: 0 12px 36px color-mix(in srgb, var(--void) 80%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 768px) {
    .cta-panel {
      padding: var(--space-3xl) var(--space-2xl);
    }
  }

  .cta-telemetry {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--astrophage);
    background: color-mix(in srgb, var(--astrophage) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--astrophage) 35%, transparent);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-sm) 0;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--star);
    max-width: 600px;
    margin: 0 0 var(--space-xl) 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    background: linear-gradient(135deg, var(--orbit), var(--dusk));
    color: var(--moon);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--orbit) 50%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--orbit) 40%, transparent);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0 32px color-mix(in srgb, var(--orbit) 65%, transparent);
    color: #ffffff;
    outline: none;
  }
</style>
