---
/**
 * =====================================================================
 * CALLISTO DEEP SPACE OBSERVATORY & ASTRODYNAMICS ENGINE
 * =====================================================================
 * Architect & Developer: vijayraj.s
 * GitHub Profile: https://github.com/Vijajraj
 * Repository: https://github.com/Vijajraj/Callisto_website
 * =====================================================================
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { departments, getOfficersByDepartment, type Department } from '../../data/departments';

export function getStaticPaths() {
  return departments.map((dept) => ({
    params: { department: dept.id },
    props: { dept },
  }));
}

interface Props {
  dept: Department;
}

const { dept } = Astro.props;
const deptOfficers = getOfficersByDepartment(dept.id);
---

<BaseLayout
  title={`${dept.themedName} (${dept.name}) | Callisto Ship Manifest`}
  description={`Department Dossier: ${dept.themedName} (${dept.name}), commanded by ${dept.lead}.`}
>
  <div class="dept-page-container">
    <!-- Back Navigation Link -->
    <nav class="back-nav" aria-label="Breadcrumb navigation">
      <a href="/crew" class="back-link">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        <span>Back to Ship Manifest</span>
      </a>
    </nav>

    <!-- Department Hero -->
    <header class="dept-hero">
      <div class="dept-meta-row">
        {dept.shipModule ? <span class="module-chip">{dept.shipModule}</span> : <span class="module-chip-empty"></span>}
        <span class="dept-icon-display" aria-hidden="true">
          {dept.icon && (dept.icon.startsWith('/') || dept.icon.includes('.')) ? (
            <img src={dept.icon} alt="" width="48" height="48" class="dept-hero-icon-img" />
          ) : (
            dept.icon
          )}
        </span>
      </div>

      <h1 class="dept-title">{dept.themedName}</h1>
      <p class="dept-subtitle">{dept.name}</p>

      <div class="lead-officer-banner">
        <div class="lead-officer-item">
          <span class="lead-label">ROLE ASSIGNED:</span>
          <span class="lead-value">{dept.lead}</span>
        </div>
        {dept.role && (
          <div class="lead-officer-item">
            <span class="lead-label">ROLE:</span>
            <span class="lead-role-pill">{dept.role}</span>
          </div>
        )}
      </div>
    </header>

    <div class="dept-content-grid">
      <!-- Left Column: Department Description & Mission Profile -->
      <div class="main-column">
        <section class="section-card" aria-labelledby="mission-profile-heading">
          <h2 id="mission-profile-heading" class="card-heading">Mission Profile</h2>
          {dept.description ? (
            <div class="prose">
              <p>{dept.description}</p>
            </div>
          ) : (
            <div class="blank-slot" aria-label="Department description to be added in future">
              <!-- Blank slot kept for future user information -->
            </div>
          )}
        </section>

        {deptOfficers.length > 0 && (
          <section class="section-card" aria-labelledby="officers-heading">
            <h2 id="officers-heading" class="card-heading">Station Officers & Flight Leads</h2>
            <div class="dept-officers-grid">
              {deptOfficers.map((officer) => (
                <div class="dept-officer-card">
                  <div class="dept-officer-header">
                    <img
                      src={officer.avatar}
                      alt={`${officer.name} avatar`}
                      width="64"
                      height="64"
                      class="dept-officer-avatar"
                      loading="lazy"
                    />
                    <div class="dept-officer-info">
                      <h3 class="dept-officer-name">{officer.name}</h3>
                      <div class="dept-officer-role-tag">{officer.role}</div>
                      <div class="dept-officer-term">TERM: {officer.term}</div>
                    </div>
                  </div>

                  <p class="dept-officer-desc">{officer.description}</p>

                  <div class="dept-officer-socials" aria-label={`Connect with ${officer.name}`}>
                    {officer.socialLinks.github && (
                      <a href={officer.socialLinks.github} target="_blank" rel="noopener noreferrer" class="dept-social-link" title="GitHub" aria-label={`${officer.name} on GitHub`}>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" /></svg>
                      </a>
                    )}
                    {officer.socialLinks.linkedin && (
                      <a href={officer.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="dept-social-link" title="LinkedIn" aria-label={`${officer.name} on LinkedIn`}>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
                      </a>
                    )}
                    {officer.socialLinks.comms && (
                      <a href={officer.socialLinks.comms} class="dept-social-link" title="Comms" aria-label={`Send comms to ${officer.name}`}>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l10 8.104 10-8.104v11.817h-20z" /></svg>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Open Roles Section -->
        <section class="section-card" aria-labelledby="roles-heading">
          <h2 id="roles-heading" class="card-heading">Department Roles & Assignments</h2>
          {dept.openRoles && dept.openRoles.length > 0 ? (
            <ul class="roles-list">
              {dept.openRoles.map((role) => (
                <li class="role-item">
                  <div class="role-bullet" aria-hidden="true"></div>
                  <div class="role-details">
                    <span class="role-name">{role}</span>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <div class="blank-slot" aria-label="Department roles to be added in future">
              <!-- Blank slot kept for future user information -->
            </div>
          )}

          <div class="apply-cta-box">
            <a href="/join" class="btn-primary">
              <span>Join {dept.themedName}</span>
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </section>
      </div>

      <!-- Right Column: Department Manifest Sidebar -->
      <aside class="sidebar-column" aria-label="Department Dossier">
        <div class="schematic-card">
          <div class="schematic-header">
            <span class="schematic-title">DEPARTMENT DOSSIER</span>
            <span class="schematic-code">{dept.id.toUpperCase()}</span>
          </div>

          <div class="schematic-details">
            <div class="telemetry-row">
              <span class="telemetry-label">THEMED NAME:</span>
              <span class="telemetry-value">{dept.themedName}</span>
            </div>
            <div class="telemetry-row">
              <span class="telemetry-label">DEPARTMENT:</span>
              <span class="telemetry-value">{dept.name}</span>
            </div>
            <div class="telemetry-row">
              <span class="telemetry-label">ROLE ASSIGNED:</span>
              <span class="telemetry-value">{dept.lead}</span>
            </div>
            {dept.role && (
              <div class="telemetry-row">
                <span class="telemetry-label">ROLE:</span>
                <span class="telemetry-value">{dept.role}</span>
              </div>
            )}

            <!-- Blank area for future department telemetry -->
            <div class="blank-sidebar-slot" aria-label="Additional telemetry to be added in future"></div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .dept-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .dept-page-container {
      padding: var(--space-2xl) var(--space-xl) var(--space-3xl);
    }
  }

  .back-nav {
    margin-bottom: var(--space-xl);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--star);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--moon);
    transform: translateX(-3px);
  }

  .dept-hero {
    background: linear-gradient(135deg, color-mix(in srgb, var(--navy) 50%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    margin-bottom: var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  .dept-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .module-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--orbit);
    background: color-mix(in srgb, var(--navy) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .dept-icon-display {
    font-size: 2rem;
    line-height: 1;
  }

  .dept-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .dept-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--star);
    margin: 0 0 var(--space-xl) 0;
  }

  .lead-officer-banner {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    background: color-mix(in srgb, var(--navy) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    padding: 0.55rem 1.25rem;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .lead-officer-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lead-label {
    color: var(--steel);
    font-weight: 500;
  }

  .lead-value {
    color: var(--astrophage);
    font-weight: 600;
  }

  .lead-role-pill {
    display: inline-block;
    color: var(--star);
    background: rgba(156, 132, 214, 0.2);
    border: 1px solid rgba(156, 132, 214, 0.4);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .dept-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .dept-content-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .section-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .card-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-lg) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
    padding-bottom: var(--space-xs);
  }

  /* Blank slots kept for user future content */
  .blank-slot {
    min-height: 5rem;
    border: 1px dashed color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--void) 30%, transparent);
    margin-bottom: var(--space-md);
  }

  .blank-sidebar-slot {
    min-height: 6rem;
    border: 1px dashed color-mix(in srgb, var(--steel) 25%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--void) 30%, transparent);
    margin-top: var(--space-md);
  }

  .prose {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--star);
  }

  .apply-cta-box {
    margin-top: var(--space-xl);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, var(--orbit), var(--dusk));
    color: var(--moon);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--orbit) 50%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0 20px color-mix(in srgb, var(--orbit) 50%, transparent);
    outline: none;
  }

  .schematic-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .schematic-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
    padding-bottom: var(--space-xs);
  }

  .schematic-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--star);
    letter-spacing: 0.1em;
  }

  .schematic-code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--orbit);
  }

  .telemetry-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 15%, transparent);
  }

  .telemetry-label {
    color: var(--steel);
    font-size: 0.6875rem;
  }

  .telemetry-value {
    color: var(--moon);
    font-weight: 500;
    text-align: right;
  }

  /* Department Officers Styles */
  .dept-officers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .dept-officers-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
  }

  .dept-officer-card {
    background: var(--navy);
    border: 1px solid var(--dusk);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .dept-officer-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .dept-officer-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dept-officer-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--moon);
    margin: 0 0 2px;
    line-height: 1.2;
  }

  .dept-officer-role-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--astrophage);
    font-weight: 600;
    margin-bottom: 2px;
  }

  .dept-officer-term {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--steel);
    letter-spacing: 0.05em;
  }

  .dept-officer-desc {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--steel);
    line-height: 1.5;
    margin: 0 0 var(--space-md);
  }

  .dept-officer-socials {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--dusk);
  }

  .dept-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--steel) 12%, transparent);
    color: var(--steel);
    transition: all 0.2s ease;
  }

  .dept-social-link:hover {
    background: var(--astrophage);
    color: #000000;
    transform: translateY(-1px);
  }
</style>
