---
import { getSolCount } from '../lib/utils';

const solCount = getSolCount();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signal Lost (404) | Callisto Expedition</title>
    <meta name="description" content="Coordinates not recognized. Signal lost in deep space." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#060919" />

    <style>
      :root {
        --void: #0b0507;
        --deep: #160b10;
        --navy: #2b121c;
        --steel: #8c7f87;
        --dusk: #7f1d1d;
        --orbit: #f43f5e;
        --star: #ffb399;
        --moon: #fff5f5;
        --sol-dust: #e05a2b;
        --astrophage: #ff6633;

        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', 'Courier New', monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        background-color: var(--void);
        color: var(--moon);
        font-family: var(--font-body);
        overflow: hidden;
      }

      .error-container {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem 1.5rem;
        background: radial-gradient(circle at center, color-mix(in srgb, var(--navy) 45%, transparent) 0%, var(--void) 75%);
      }

      /* Sol Counter in Top Right Corner */
      .sol-counter {
        position: absolute;
        top: 2rem;
        right: 2rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        letter-spacing: 0.15em;
        color: var(--steel);
        background: color-mix(in srgb, var(--navy) 60%, transparent);
        border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .sol-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--sol-dust);
        box-shadow: 0 0 8px var(--sol-dust);
      }

      /* Rotating Star Centerpiece */
      .star-wrapper {
        width: 140px;
        height: 140px;
        margin-bottom: 2rem;
        animation: rotateGentle 30s linear infinite;
        filter: drop-shadow(0 0 24px color-mix(in srgb, var(--orbit) 50%, transparent));
      }

      @keyframes rotateGentle {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      .star-svg {
        width: 100%;
        height: 100%;
      }

      /* Status Telemetry */
      .error-status {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--astrophage);
        margin-bottom: 0.5rem;
      }

      /* Heading */
      .error-heading {
        font-family: var(--font-display);
        font-size: clamp(3rem, 7vw, 5.5rem);
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--moon);
        line-height: 1.05;
        margin-bottom: 1.25rem;
        text-shadow: 0 0 30px color-mix(in srgb, var(--orbit) 40%, transparent);
      }

      /* Description */
      .error-desc {
        font-family: var(--font-body);
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.6;
        color: var(--star);
        max-width: 520px;
        margin-bottom: 2.5rem;
      }

      /* Action Button */
      .return-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.85rem 2rem;
        background: linear-gradient(135deg, var(--orbit), var(--dusk));
        color: var(--moon);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 8px;
        border: 1px solid color-mix(in srgb, var(--orbit) 50%, transparent);
        box-shadow: 0 0 24px color-mix(in srgb, var(--orbit) 40%, transparent);
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      }

      .return-btn:hover,
      .return-btn:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 0 32px color-mix(in srgb, var(--orbit) 70%, transparent);
        filter: brightness(1.1);
        color: #ffffff;
        outline: none;
      }

      /* Coordinates Glitch Decorator */
      .coordinates-decor {
        position: absolute;
        bottom: 2rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.15em;
        color: var(--steel);
        opacity: 0.7;
      }

      @media (prefers-reduced-motion: reduce) {
        .star-wrapper {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <main class="error-container" role="main">
      <!-- Sol Counter in corner -->
      <div class="sol-counter" aria-label={`Mission Sol ${solCount}`}>
        <span class="sol-dot" aria-hidden="true"></span>
        <span>SOL {solCount}</span>
      </div>

      <!-- Logo / Insignia Emblem -->
      <div class="star-wrapper" aria-hidden="true">
        <img
          src="/logo.jpg"
          alt="Callisto Insignia"
          width="88"
          height="88"
          style="border-radius: 50%; box-shadow: 0 0 24px rgba(244, 63, 94, 0.55); border: 2px solid rgba(244, 63, 94, 0.4); object-fit: cover;"
        />
      </div>

      <div class="error-status">COMMUNICATION VECTOR UNREACHABLE</div>
      <h1 class="error-heading">SIGNAL LOST</h1>

      <p class="error-desc">
        404 — The coordinates you entered don’t match any known destination in the stellar catalog.
      </p>

      <a href="/" class="return-btn">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        <span>Return to Base</span>
      </a>

      <div class="coordinates-decor" aria-hidden="true">
        GRID-LOC: [RA 00h 00m 00s / DEC -90° 00' 00"] // DRIFT VELOCITY: 0 km/s
      </div>
    </main>
  </body>
</html>
