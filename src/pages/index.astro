import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DepartmentCard from '../components/DepartmentCard.astro';
import CrescentLoader from '../components/react/CrescentLoader';
import EventCountdown from '../components/react/EventCountdown';
import SolarSystemOrrery from '../components/react/SolarSystemOrrery';
import PodcastTransmission from '../components/react/PodcastTransmission';
import { departments } from '../data/departments';
import { getUpcomingEvents } from '../data/events';
import { getSolCount } from '../lib/utils';

const solCount = getSolCount();
const upcomingEvents = getUpcomingEvents();
const nextEvent = upcomingEvents.length > 0 ? upcomingEvents[0] : null;

const previewDepartments = departments.slice(0, 5);
---

<BaseLayout title="Callisto | Space Expedition & Astronomy Club" description="Embark on an expedition into observational astrophysics, space robotics, and celestial cartography with Callisto Club.">
  <!-- Act 0 Opening Sequence Overlay -->
  <CrescentLoader client:load />

  <!-- Hero Section -->
  <section class="hero-section" aria-label="Expedition Hero">
    <div class="sol-badge" aria-label={`Mission Sol ${solCount}`}>
      <span class="sol-dot"></span>
      <span class="sol-text">SOL {solCount}</span>
    </div>

    <div class="hero-content">
      <div class="hero-logo-frame">
        <img
          src="/logo.jpg"
          alt="Callisto Club Insignia"
          width="96"
          height="96"
          class="hero-logo-img"
        />
      </div>
      <p class="hero-eyebrow">ASTRONOMY &amp; ASTROPHYSICS</p>
      <h1 class="hero-title">CALLISTO CLUB</h1>
      <p class="hero-tagline">
        A journey to the edge of wonder. Explore the nocturnal cosmos with us.
      </p>

      <div class="hero-cta-group">
        <a href="/observatory" class="btn-primary">
          <img src="/icons/icon-observatory.png" alt="" width="20" height="20" class="btn-page-icon" aria-hidden="true" />
          <span>Explore Observatory</span>
        </a>
        <a href="/avatar" class="btn-outline">
          <img src="/icons/icon-suit-lab.png" alt="" width="20" height="20" class="btn-page-icon" aria-hidden="true" />
          <span>Suit Lab</span>
        </a>
      </div>

      <!-- Telemetry Coordinates Strip (FREX Inspired) -->
      <div class="hero-telemetry-strip" aria-hidden="true">
        <span class="telemetry-coord">LAT: 12.9716° N</span>
        <span class="telemetry-sep">//</span>
        <span class="telemetry-coord">LON: 80.0435° E</span>
        <span class="telemetry-sep">//</span>
        <span class="telemetry-coord">ELEV: 54m</span>
        <span class="telemetry-sep">//</span>
        <span class="telemetry-coord">AZ: 184.2°</span>
        <span class="telemetry-sep">//</span>
        <span class="telemetry-coord">ALT: +42.8°</span>
        <span class="telemetry-sep">//</span>
        <span class="telemetry-status">STATION: ONLINE</span>
      </div>
    </div>

    <!-- Atmospheric Horizon Glow Arc (FREX Inspired) -->
    <div class="earth-horizon-glow" aria-hidden="true">
      <div class="horizon-arc"></div>
      <div class="atmosphere-haze"></div>
    </div>

    <!-- Scroll Indicator -->
    <a href="#mission-brief" class="scroll-indicator" aria-label="Scroll down to Mission Brief">
      <span class="scroll-text">Scroll to explore</span>
      <svg class="scroll-chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </a>
  </section>

  <!-- Track Record & Impact Metrics Banner -->
  <section class="metrics-banner-section" aria-label="Callisto Impact & Exploration Metrics">
    <div class="content-wrapper">
      <div class="metrics-grid">
        <div class="metric-card">
          <span class="metric-val">500+</span>
          <span class="metric-label">Active Cadets &amp; Observers</span>
          <span class="metric-detail">Across 11 Specialized Wings</span>
        </div>
        <div class="metric-card">
          <span class="metric-val">25+</span>
          <span class="metric-label">Stargazing Expeditions</span>
          <span class="metric-detail">Campus Rooftops &amp; Dark-Sky Camps</span>
        </div>
        <div class="metric-card">
          <span class="metric-val">50+</span>
          <span class="metric-label">Deep-Sky Objects Imaged</span>
          <span class="metric-detail">Nebulae, Galaxies &amp; Star Clusters</span>
        </div>
        <div class="metric-card">
          <span class="metric-val">12+</span>
          <span class="metric-label">Technical Workshops</span>
          <span class="metric-detail">Optics, Astropy &amp; Astrophotography</span>
        </div>
        <div class="metric-card">
          <span class="metric-val">3</span>
          <span class="metric-label">StarCast Audio Broadcasts</span>
          <span class="metric-detail">Streaming on Spotify Worldwide</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Brief Section -->
  <section id="mission-brief" class="mission-brief-section">
    <div class="content-wrapper">
      <SectionHeading
        mono="MISSION BRIEF"
        title="Why Callisto?"
        subtitle="Named after the ancient, cratered moon orbiting Jupiter, we are a collective of student astronomers, engineers, and dreamers dedicated to exploring the nocturnal frontier."
        align="center"
      />

      <div class="brief-grid">
        <article class="brief-card">
          <div class="brief-icon" aria-hidden="true">
            <img src="/icons/icon-explore.png" alt="" width="48" height="48" class="brief-icon-img" />
          </div>
          <h3 class="brief-title">Explore</h3>
          <p class="brief-desc">
            Deploy motorized optical arrays under pristine dark skies. Track lunar occultations, Messier deep-sky objects, and meteor showers through live telescopic sessions.
          </p>
        </article>

        <article class="brief-card">
          <div class="brief-icon" aria-hidden="true">
            <img src="/icons/icon-learn.png" alt="" width="48" height="48" class="brief-icon-img" />
          </div>
          <h3 class="brief-title">Learn</h3>
          <p class="brief-desc">
            Master photometric light curve reduction, exoplanet transit modeling, and astrophotography stacking. Learn alongside faculty mentors and visiting astrophysicists.
          </p>
        </article>

        <article class="brief-card">
          <div class="brief-icon" aria-hidden="true">
            <img src="/icons/icon-connect.png" alt="" width="48" height="48" class="brief-icon-img" />
          </div>
          <h3 class="brief-title">Connect</h3>
          <p class="brief-desc">
            Find your flight crew among 11 interdisciplinary ship wings. Build enduring bonds at stargazing campouts, campus hackathons, and global space symposia.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Interactive Solar System Orrery Section -->
  <section class="orrery-section" aria-label="Interactive Solar System Orrery">
    <div class="content-wrapper">
      <SectionHeading
        mono="HELIOCENTRIC HARBOR"
        title="Interactive Solar System Orrery"
        subtitle="Simulate real-time Keplerian orbital motions across all eight major planets and the radiant Sun. Inspect interplanetary distances, surface temperatures, and deep-space telemetry."
        align="center"
      />
      <div class="orrery-island-wrapper">
        <SolarSystemOrrery client:visible />
      </div>
    </div>
  </section>

  <!-- Planned Missions & Research Roadmap Section -->
  <section class="missions-roadmap-section" aria-label="Planned Missions & Research Roadmap">
    <div class="content-wrapper">
      <div class="roadmap-header-flex">
        <SectionHeading
          mono="PROJECT BLUEPRINTS // ROADMAP 2026-2027"
          title="Planned Missions &amp; Research Initiatives"
          subtitle="We are in active team-formation and conceptual architecture phases. Explore our proposed project roadmaps and join as a founding contributor."
          align="left"
        />
        <a href="/join" class="btn-outline roadmap-cta-btn">
          <span>Join a Project Team &rarr;</span>
        </a>
      </div>

      <div class="roadmap-grid">
        <!-- Card 1: Project Caelum -->
        <article class="roadmap-card">
          <div class="roadmap-card-top">
            <span class="roadmap-badge proposed">PROPOSED // CONCEPT PHASE</span>
            <span class="roadmap-domain">AVIONICS &amp; EMBEDDED TELEMETRY</span>
          </div>
          <h3 class="roadmap-title">Project Caelum: High-Altitude Atmospheric Probe</h3>
          <p class="roadmap-desc">
            Conceptual stratospheric balloon payload engineered to gather real-time environmental telemetry (UV irradiance, barometric pressure, temperature lapse rate) with autonomous GPS recovery and 433MHz LoRa downlink.
          </p>
          <div class="roadmap-specs-table">
            <div class="spec-row">
              <span class="spec-k">TARGET TIMELINE:</span>
              <span class="spec-v">Q4 2027 Kickoff</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">CORE STACK:</span>
              <span class="spec-v">ESP32, LoRa SX1278, BMP388, KiCad</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">OPEN ROLES:</span>
              <span class="spec-v">Firmware Leads, RF Comms, Payload Recovery</span>
            </div>
          </div>
          <div class="roadmap-card-foot">
            <a href="/join" class="roadmap-apply-link">Apply to Lead Caelum &rarr;</a>
          </div>
        </article>

        <!-- Card 2: Project Aether-Eye -->
        <article class="roadmap-card">
          <div class="roadmap-card-top">
            <span class="roadmap-badge kickoff">KICKOFF PHASE // TEAM FORMATION</span>
            <span class="roadmap-domain">OPTICS &amp; ASTROPHOTOGRAPHY</span>
          </div>
          <h3 class="roadmap-title">Project Aether-Eye: Open-Source Star Tracker</h3>
          <p class="roadmap-desc">
            Designing a 3D-printable, stepper-driven motorized equatorial tracking mount for wide-field DSLR and mirrorless astrophotography, compensating for Earth’s sidereal rotation for deep exposures.
          </p>
          <div class="roadmap-specs-table">
            <div class="spec-row">
              <span class="spec-k">TARGET TIMELINE:</span>
              <span class="spec-v">Q2 2027 Prototype</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">CORE STACK:</span>
              <span class="spec-v">TMC2209 Drivers, NEMA 17, Arduino, CAD</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">OPEN ROLES:</span>
              <span class="spec-v">Mechanical Designers, Embedded Control, Optics</span>
            </div>
          </div>
          <div class="roadmap-card-foot">
            <a href="/join" class="roadmap-apply-link">Apply to Lead Aether-Eye &rarr;</a>
          </div>
        </article>

        <!-- Card 3: Citizen Science & Exoplanet Photometry -->
        <article class="roadmap-card">
          <div class="roadmap-card-top">
            <span class="roadmap-badge research">RESEARCH ROADMAP // RECRUITING</span>
            <span class="roadmap-domain">ASTROPHYSICS &amp; DATA SCIENCE</span>
          </div>
          <h3 class="roadmap-title">Citizen Science: Exoplanet Transit Photometry</h3>
          <p class="roadmap-desc">
            Open scientific research pipeline utilizing public NASA TESS &amp; Kepler light curve data to perform differential transit photometry, planetary radius estimation, and stellar variability cataloging.
          </p>
          <div class="roadmap-specs-table">
            <div class="spec-row">
              <span class="spec-k">TARGET TIMELINE:</span>
              <span class="spec-v">Ongoing 2026-2027</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">CORE STACK:</span>
              <span class="spec-v">Python, Lightkurve, Astropy, Jupyter</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">OPEN ROLES:</span>
              <span class="spec-v">Data Analysts, Transit Modelers, Paper Drafters</span>
            </div>
          </div>
          <div class="roadmap-card-foot">
            <a href="/join" class="roadmap-apply-link">Apply to Research Cohort &rarr;</a>
          </div>
        </article>

        <!-- Card 4: CanSat Micro-Avionics Testbed -->
        <article class="roadmap-card">
          <div class="roadmap-card-top">
            <span class="roadmap-badge proposed">PROPOSED // CADET ROADMAP</span>
            <span class="roadmap-domain">SPACE SYSTEMS &amp; SIMULATION</span>
          </div>
          <h3 class="roadmap-title">CanSat Micro-Avionics Testbed</h3>
          <p class="roadmap-desc">
            Introductory aerospace hardware challenge: designing a beverage-can scale atmospheric satellite with sensor telemetry logging, parachute recovery mechanisms, and a live web telemetry ground station.
          </p>
          <div class="roadmap-specs-table">
            <div class="spec-row">
              <span class="spec-k">TARGET TIMELINE:</span>
              <span class="spec-v">Academic Year 2026-2027</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">CORE STACK:</span>
              <span class="spec-v">Custom PCB, Gyro/IMU, Barometer, Telemetry GUI</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">OPEN ROLES:</span>
              <span class="spec-v">Cadet Builders, PCB Enthusiasts, Recovery Teams</span>
            </div>
          </div>
          <div class="roadmap-card-foot">
            <a href="/join" class="roadmap-apply-link">Apply to Join CanSat &rarr;</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Next Launch Section -->
  <section class="next-launch-section" aria-label="Upcoming Event">
    <div class="content-wrapper">
      <SectionHeading
        mono="NEXT LAUNCH"
        title="Upcoming Event"
        subtitle="The launchpad is prepped. Count down to our next scheduled celestial observation or mission workshop."
        align="center"
      />

      {nextEvent ? (
        <div class="countdown-container">
          <EventCountdown
            client:visible
            targetDate={nextEvent.date}
            eventTitle={nextEvent.title}
          />

          <div class="event-brief-box">
            <div class="event-brief-meta">
              <span class="brief-pill">MISSION READY</span>
              <span class="brief-date">{new Date(nextEvent.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            </div>
            <h3 class="event-brief-title">{nextEvent.title}</h3>
            <p class="event-brief-desc">{nextEvent.description}</p>
            <div class="event-actions">
              <a href={`/events/${nextEvent.slug}`} class="btn-primary">
                <span>View Mission Dossier</span>
                <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
              <a href="/events" class="link-secondary">
                <span>View All Events &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      ) : (
        <div class="event-blank-slot" aria-label="Upcoming event slot kept blank for future event schedule">
          <!-- Blank slot kept for user future events -->
        </div>
      )}
    </div>
  </section>

  <!-- Departments Preview Section -->
  <section class="departments-section" aria-label="Meet the Crew">
    <div class="content-wrapper">
      <div class="section-header-flex">
        <SectionHeading
          mono="THE SHIP"
          title="Meet the Crew"
          subtitle="Every department represents a mission-critical module aboard our expedition vessel."
          align="left"
        />
        <a href="/crew" class="desktop-view-all-link">
          <span>Explore All Departments</span>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <!-- Horizontal Scrollable Track -->
      <div class="horizontal-scroll-container" tabindex="0" role="region" aria-label="Departments scroll gallery">
        <div class="horizontal-scroll-track">
          {previewDepartments.map((dept) => (
            <div class="scroll-card-item">
              <DepartmentCard
                id={dept.id}
                name={dept.name}
                themedName={dept.themedName}
                lead={dept.lead}
                role={dept.role}
                shipModule={dept.shipModule}
                description={dept.description}
                icon={dept.icon}
              />
            </div>
          ))}
        </div>
      </div>

      <div class="mobile-view-all">
        <a href="/crew" class="btn-outline full-width">
          <span>Explore All 11 Departments &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Cosmic Podcast Audio Broadcast Section -->
  <section class="podcast-broadcast-section" aria-label="Whispers of the Universe Podcast">
    <div class="content-wrapper">
      <SectionHeading
        mono="AUDIO TRANSMISSION // STARCAST RADIO"
        title="Whispers of the Universe &amp; Scent Beyond the Horizon"
        subtitle="Tune into Callisto's official astrophysics podcast hosted by Sanjay V V. Streaming deep-space cosmological investigations, Voyager 1 extrasolar telemetry, and astrochemistry across 3 episodes on Spotify."
        align="left"
      />
      <PodcastTransmission client:load />
    </div>
  </section>

  <!-- Join CTA Section -->
  <section class="join-cta-section" aria-label="Join Callisto">
    <div class="cta-inner">
      <div class="cta-badge">CREW RECRUITMENT OPEN</div>
      <h2 class="cta-heading">Ready to Board?</h2>
      <p class="cta-subtitle">
        Join the expedition and become part of something extraordinary. We welcome all cadets, researchers, designers, and stargazers.
      </p>
      <div class="cta-buttons">
        <a href="/join" class="btn-primary cta-btn">
          <span>Request Boarding</span>
          <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/about" class="btn-outline cta-btn">
          <span>Read Mission Charter</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Common Container */
  .content-wrapper {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  @media (min-width: 768px) {
    .content-wrapper {
      padding: 0 var(--space-xl);
    }
  }

  /* 1. Hero Section */
  .hero-section {
    position: relative;
    min-height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-3xl) var(--space-md) var(--space-2xl);
    overflow: hidden;
  }

  /* Sol Badge */
  .sol-badge {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: color-mix(in srgb, var(--navy) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--steel) 35%, transparent);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 10;
  }

  .sol-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--sol-dust);
    box-shadow: 0 0 8px var(--sol-dust);
  }

  .sol-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--star);
  }

  .hero-content {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 5;
  }

  .hero-logo-frame {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
    position: relative;
  }

  .hero-logo-img {
    width: clamp(84px, 10vw, 110px);
    height: clamp(84px, 10vw, 110px);
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.45), 0 0 60px rgba(255, 255, 255, 0.2);
    animation: heroLogoFloat 4s ease-in-out infinite;
  }

  @keyframes heroLogoFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .brief-icon-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.35));
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.2vw, 0.9375rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--steel);
    margin: 0 0 var(--space-sm) 0;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: var(--moon);
    margin: 0 0 var(--space-lg) 0;
    text-shadow: 0 0 40px color-mix(in srgb, var(--orbit) 35%, transparent);
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: var(--star);
    max-width: 620px;
    margin: 0 0 var(--space-2xl) 0;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  /* General Button Styles */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
