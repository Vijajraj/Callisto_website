---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const classifiedMissions = [
  {
    code: 'CAL-MSN-001',
    title: 'Project Borealis: High-Altitude Atmospheric Probe',
    leadWing: 'Tesseract & Aether Wing',
    status: 'DATA REDUCTION STAGE',
    classification: 'SECURITY LEVEL 2',
    desc: 'Deploying custom meteorological telemetry balloons equipped with cosmic ray sensors, barometric arrays, and high-altitude wide-angle CMOS imagers to sample upper atmospheric ionization layers.',
    icon: '🎈',
    accentColor: 'var(--orbit)',
  },
  {
    code: 'CAL-MSN-002',
    title: 'Helios Array: Automated Solar Spectroscopy Rig',
    leadWing: 'LUNAR Society & Studio',
    status: 'INSTRUMENTATION INTEGRATION',
    classification: 'SECURITY LEVEL 1',
    desc: 'Constructing a motorized heliostat mounting system coupled with hydrogen-alpha solar filters and diffraction gratings for daily solar flare and sunspot tracking from the campus observatory rooftop.',
    icon: '☀️',
    accentColor: 'var(--astrophage)',
  },
  {
    code: 'CAL-MSN-003',
    title: 'Deep-Sky Survey: Messier Robotic Cataloging',
    leadWing: 'Observational Astronomy Wing',
    status: 'FIELD DEPLOYMENT TESTING',
    classification: 'SECURITY LEVEL 2',
    desc: 'An automated astrophotography script integrating plate-solving algorithms with open-source telescope mounts to systematically catalog all 110 Messier deep-sky objects across four astronomical seasons.',
    icon: '🌌',
    accentColor: 'var(--star)',
  },
];
---

<BaseLayout
  title="Active Missions & Research Projects | Callisto Club"
  description="Explore active research missions, high-altitude probes, and observational campaigns spearheaded by Callisto Club engineers."
>
  <div class="missions-container">
    <!-- Header -->
    <header class="missions-header">
      <SectionHeading
        mono="ACTIVE MISSIONS"
        title="Our Projects"
        subtitle="Our research and outreach missions are currently being classified. Check back soon for mission briefings."
        align="center"
      />
    </header>

    <!-- Missions Grid -->
    <section class="missions-grid-section" aria-label="Classified Mission Projects">
      <div class="missions-grid">
        {classifiedMissions.map((mission) => (
          <article
            class="mission-card"
            style={`--m-accent: ${mission.accentColor};`}
          >
            <div class="card-header">
              <span class="mission-code">{mission.code}</span>
              <span class="mission-icon" aria-hidden="true">{mission.icon}</span>
            </div>

            <h3 class="mission-title">{mission.title}</h3>

            <div class="mission-meta">
              <div class="meta-row">
                <span class="meta-label">LEAD WING:</span>
                <span class="meta-value">{mission.leadWing}</span>
              </div>
              <div class="meta-row">
                <span class="meta-label">STATUS:</span>
                <span class="meta-value status-badge">{mission.status}</span>
              </div>
            </div>

            <p class="mission-desc">{mission.desc}</p>

            <div class="mission-footer">
              <span class="classification-tag">{mission.classification}</span>
              <span class="dossier-pill">Dossier Classified</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Propose Mission CTA -->
    <section class="propose-cta-section" aria-label="Propose a Mission">
      <div class="propose-panel">
        <div class="propose-badge">CALL FOR PROPOSALS</div>
        <h2 class="propose-title">Have a Mission Idea? Propose One</h2>
        <p class="propose-desc">
          Do you have a thesis proposal, hardware prototype, or observational experiment you want to launch? Callisto Club provides research seed funding, scopes, and peer engineering teams.
        </p>
        <a href="/contact" class="btn-primary">
          <span>Submit Project Proposal</span>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .missions-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .missions-container {
      padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    }
  }

  .missions-header {
    margin-bottom: var(--space-2xl);
  }

  .missions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-3xl);
  }

  @media (min-width: 768px) {
    .missions-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .mission-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .mission-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--m-accent);
  }

  .mission-card:hover {
    transform: translateY(-4px);
    border-color: var(--m-accent);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--m-accent) 20%, transparent);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .mission-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--m-accent);
    letter-spacing: 0.1em;
  }

  .mission-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .mission-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--moon);
    margin: 0 0 var(--space-md) 0;
  }

  .mission-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .meta-label {
    color: var(--steel);
    font-size: 0.6875rem;
  }

  .meta-value {
    color: var(--star);
    font-weight: 500;
  }

  .status-badge {
    color: var(--astrophage);
  }

  .mission-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--steel);
    margin: 0 0 var(--space-lg) 0;
    flex: 1;
  }

  .mission-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-sm);
    border-top: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
  }

  .classification-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--steel);
    letter-spacing: 0.08em;
  }

  .dossier-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--orbit);
  }

  /* Propose Panel */
  .propose-cta-section {
    margin-top: var(--space-xl);
  }

  .propose-panel {
    background: linear-gradient(145deg, color-mix(in srgb, var(--navy) 60%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .propose-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--astrophage);
    background: color-mix(in srgb, var(--astrophage) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--astrophage) 35%, transparent);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-sm);
  }

  .propose-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .propose-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--star);
    max-width: 600px;
    margin: 0 0 var(--space-xl) 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    background: linear-gradient(135deg, var(--orbit), var(--dusk));
    color: var(--moon);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--orbit) 50%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--orbit) 35%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0 28px color-mix(in srgb, var(--orbit) 60%, transparent);
    color: #ffffff;
    outline: none;
  }
</style>
