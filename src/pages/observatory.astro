---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TelescopeSimulator from '../components/react/TelescopeSimulator';

const celestialTargets = [
  { name: 'Jupiter (Great Red Spot Transit)', constellation: 'Taurus', magnitude: '-2.7', bestViewing: '22:00 – 02:30 IST' },
  { name: 'Saturn & Ring Plane Angle', constellation: 'Aquarius', magnitude: '+0.7', bestViewing: '19:30 – 23:00 IST' },
  { name: 'Orion Nebula (M42 / NGC 1976)', constellation: 'Orion', magnitude: '+4.0', bestViewing: '00:30 – 04:30 IST' },
  { name: 'Andromeda Galaxy (M31)', constellation: 'Andromeda', magnitude: '+3.4', bestViewing: '20:00 – 01:00 IST' },
];
---

<BaseLayout
  title="The Observatory & Sky Logs | Callisto Club"
  description="Sky charts, observation forecasts, featured astronomical science dispatches, and deep-sky imaging from Callisto Club."
>
  <div class="observatory-container">
    <!-- Header -->
    <header class="observatory-header">
      <SectionHeading
        mono="OBSERVATION LOG"
        title="The Observatory"
        subtitle="Real-time sky guides, celestial mechanics dispatches, and telescope observations from our rooftop and field arrays."
        align="center"
      />
    </header>

    <!-- Interactive Telescope Eyepiece Simulator Island -->
    <section class="simulator-section" aria-label="Interactive Optical Telescope Eyepiece">
      <TelescopeSimulator client:load />
    </section>

    <!-- Tonight's Sky Section -->
    <section class="sky-section" aria-labelledby="sky-heading">
      <div class="section-card">
        <div class="card-meta-badge">OBSERVATIONAL RADAR</div>
        <h2 id="sky-heading" class="card-title">Tonight's Sky & Ephemeris</h2>
        <p class="card-lead">
          Estimated seeing conditions from the CIT campus observation deck. Calibrate your optics for prime Jovian and deep-sky observation windows.
        </p>

        <div class="targets-table-wrapper">
          <table class="targets-table">
            <thead>
              <tr>
                <th scope="col">CELESTIAL TARGET</th>
                <th scope="col">CONSTELLATION</th>
                <th scope="col">MAGNITUDE</th>
                <th scope="col">OPTIMAL WINDOW</th>
              </tr>
            </thead>
            <tbody>
              {celestialTargets.map((target) => (
                <tr>
                  <td class="target-name">
                    <span class="target-bullet"></span>
                    {target.name}
                  </td>
                  <td class="target-constellation">{target.constellation}</td>
                  <td class="target-mag">{target.magnitude}</td>
                  <td class="target-time">{target.bestViewing}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Featured Article Section -->
    <section class="article-section" aria-labelledby="article-heading">
      <div class="article-card">
        <div class="article-badge">FEATURED DISPATCH // QUASAR JOURNAL</div>
        <h2 id="article-heading" class="article-title">The Callisto Ocean Dilemma: Magnetospheric Shielding on Jovian Ice Moons</h2>
        <div class="article-meta">
          <span>By Aether Wing Research Cohort</span>
          <span>&bull;</span>
          <span>Oct 2026 Edition</span>
          <span>&bull;</span>
          <span>8 min read</span>
        </div>
        <div class="article-prose">
          <p>
            While Europa commands mainstream astrobiological headlines for its eruptive plumes and chaotic ice terrain, its exterior neighbor Callisto offers an intriguing sanctuary. Lying outside Jupiter’s harsh inner radiation belts, Callisto undergoes far less magnetospheric sputtering.
          </p>
          <p>
            Galileo magnetometer flybys documented induced magnetic dipole fields that strongly indicate an electrically conductive, saline ocean residing 100 to 150 kilometers beneath its cratered lithosphere. In this dispatch, our astrophysics team contrasts inductive field attenuation data to model internal mantle conductivity...
          </p>
        </div>
        <div class="article-footer">
          <span class="full-article-note">Full scientific publication releasing in Callisto Journal Vol. IV</span>
        </div>
      </div>
    </section>

    <!-- APOD Section -->
    <section class="apod-section" aria-labelledby="apod-heading">
      <div class="apod-card">
        <div class="apod-badge">COSMIC ARCHIVE</div>
        <h2 id="apod-heading" class="apod-title">Astronomy Picture of the Day</h2>
        <div class="apod-placeholder-canvas">
          <div class="apod-icon" aria-hidden="true">🌌</div>
          <span class="apod-status">NASA APOD API PIPELINE INTEGRATION IN PROGRESS</span>
          <p class="apod-note">
            Our web systems team (Tesseract) is linking edge caching for NASA’s daily high-resolution astronomy stream with local metadata annotation.
          </p>
        </div>
      </div>
    </section>

    <!-- Join Content Team CTA -->
    <section class="content-cta-section" aria-label="Join Quasar Wing">
      <div class="cta-banner">
        <h3 class="cta-heading">Passionate About Science Writing & Astrophotography?</h3>
        <p class="cta-desc">
          Quasar Wing (Content & Editorial) is scouting science journalists, technical illustrators, and amateur astronomers to curate our weekly observatory dispatches.
        </p>
        <a href="/join" class="btn-primary">
          <span>Join the Editorial Crew</span>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .observatory-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  @media (min-width: 768px) {
    .observatory-container {
      padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    }
  }

  .observatory-header {
    margin-bottom: var(--space-2xl);
  }

  /* Section Card */
  .section-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-3xl);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--void) 70%, transparent);
  }

  @media (min-width: 768px) {
    .section-card {
      padding: var(--space-2xl);
    }
  }

  .card-meta-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--orbit);
    display: inline-block;
    margin-bottom: var(--space-xs);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .card-lead {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--steel);
    margin: 0 0 var(--space-xl) 0;
  }

  /* Targets Table */
  .targets-table-wrapper {
    overflow-x: auto;
  }

  .targets-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: left;
  }

  .targets-table th {
    color: var(--steel);
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
  }

  .targets-table td {
    padding: var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 15%, transparent);
    color: var(--star);
  }

  .target-name {
    color: var(--moon);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .target-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--astrophage);
    box-shadow: 0 0 6px var(--astrophage);
  }

  .target-mag {
    color: var(--orbit);
  }

  .target-time {
    color: var(--sol-dust);
  }

  /* Featured Article Card */
  .article-section {
    margin-bottom: var(--space-3xl);
  }

  .article-card {
    background: linear-gradient(145deg, color-mix(in srgb, var(--navy) 60%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: 0 10px 32px color-mix(in srgb, var(--void) 80%, transparent);
  }

  @media (min-width: 768px) {
    .article-card {
      padding: var(--space-2xl);
    }
  }

  .article-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--sol-dust);
    margin-bottom: var(--space-xs);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--moon);
    margin: 0 0 var(--space-sm) 0;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--steel);
    margin-bottom: var(--space-lg);
  }

  .article-prose p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--star);
    margin-bottom: var(--space-md);
  }

  .article-footer {
    border-top: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
    padding-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--orbit);
  }

  /* APOD Section */
  .apod-section {
    margin-bottom: var(--space-3xl);
  }

  .apod-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .apod-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--star);
    margin-bottom: var(--space-xs);
  }

  .apod-title {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-lg) 0;
  }

  .apod-placeholder-canvas {
    background-color: color-mix(in srgb, var(--navy) 50%, var(--void));
    border: 1px dashed color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .apod-icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .apod-status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--astrophage);
  }

  .apod-note {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--steel);
    max-width: 540px;
    margin: 0;
  }

  /* Content CTA Banner */
  .content-cta-section {
    margin-top: var(--space-xl);
  }

  .cta-banner {
    background: linear-gradient(135deg, color-mix(in srgb, var(--dusk) 30%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--star);
    max-width: 620px;
    margin: 0 0 var(--space-xl) 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    background: linear-gradient(135deg, var(--orbit), var(--dusk));
    color: var(--moon);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--orbit) 50%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--orbit) 35%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0 28px color-mix(in srgb, var(--orbit) 60%, transparent);
    color: #ffffff;
    outline: none;
  }
</style>
