---
/**
 * =====================================================================
 * CALLISTO DEEP SPACE OBSERVATORY & ASTRODYNAMICS ENGINE
 * =====================================================================
 * Architect & Developer: vijayraj.s
 * GitHub Profile: https://github.com/Vijajraj
 * Repository: https://github.com/Vijajraj/Callisto_website
 * =====================================================================
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NasaDeepSpaceFeed from '../components/react/NasaDeepSpaceFeed';
import TonightSkyEphemeris from '../components/react/TonightSkyEphemeris';
import PodcastTransmission from '../components/react/PodcastTransmission';

// Preload primary featured expedition asset without flooding mobile network
const preloadedAssets = [
  '/nasa/pillars-creation.svg',
];
---

<BaseLayout
  title="The Observatory & Sky Logs | Callisto Club"
  description="Sky charts, observation forecasts, featured astronomical science dispatches, and deep-sky imaging from Callisto Club."
>
  {/* High-priority asset preloading to eliminate expedition load latency */}
  {preloadedAssets.map((asset) => (
    <link rel="preload" as="image" type="image/svg+xml" href={asset} />
  ))}

  <div class="observatory-container">
    <!-- Header -->
    <header class="observatory-header">
      <SectionHeading
        mono="OBSERVATION LOG"
        title="The Observatory"
        subtitle="Real-time sky guides, celestial mechanics dispatches, and deep space telescope observations."
        align="center"
      />
    </header>

    <!-- Live NASA Deep Space & APOD Gateway Island -->
    <section class="nasa-section" aria-label="NASA Deep Space & APOD Feed">
      <NasaDeepSpaceFeed client:load />
    </section>

    <!-- Dynamic Automatic Ephemeris & Tonight's Sky Radar Island -->
    <section class="sky-section" aria-label="Dynamic Astronomical Ephemeris and Seeing Radar">
      <TonightSkyEphemeris client:load />
    </section>

    <!-- Ground Station & Field Observing Dashboard Section -->
    <section class="field-station-section" aria-label="Ground Station and Field Observation Manifest">
      <div class="field-station-card">
        <div class="field-header-row">
          <div>
            <div class="station-badge">OBSERVATIONAL GROUND STATION</div>
            <h2 class="field-title">Field Stations &amp; Optical Manifest</h2>
            <p class="field-subtitle">
              Ground-based seeing telemetry, local light pollution conditions, and computerized optical arrays deployed by Callisto astronomers.
            </p>
          </div>
          <div class="station-status-pill">
            <span class="status-indicator-dot"></span>
            <span>GROUND TELESCOPE ARRAY READY</span>
          </div>
        </div>

        <div class="field-grid">
          <!-- Sky Quality Card -->
          <div class="field-subcard">
            <div class="subcard-header">
              <span class="subcard-tag">SKY QUALITY INDEX</span>
              <h3 class="subcard-title">Observational Field Sites</h3>
            </div>
            <div class="seeing-table">
              <div class="seeing-row">
                <div class="site-meta">
                  <span class="site-name">CIT Campus Observatory</span>
                  <span class="site-loc">Latitude 12.97° N // Elevation 54m</span>
                </div>
                <div class="bortle-badge bortle-urban">
                  <span class="bortle-class">BORTLE 6-7</span>
                  <span class="bortle-desc">Suburban / Urban Sky</span>
                </div>
              </div>
              <p class="site-notes">
                Optimized for high-contrast lunar cartography, major planetary observation (Jupiter Great Red Spot, Saturn Ring Tilt), and bright binary star systems.
              </p>

              <div class="seeing-row alt-site">
                <div class="site-meta">
                  <span class="site-name">Anaikatti Dark-Sky Field Station</span>
                  <span class="site-loc">Western Ghats Foothills // Elevation 650m</span>
                </div>
                <div class="bortle-badge bortle-dark">
                  <span class="bortle-class">BORTLE 3-4</span>
                  <span class="bortle-desc">Rural Dark Sky</span>
                </div>
              </div>
              <p class="site-notes">
                Designated deep-sky astrophotography base. Low atmospheric extinction, limiting naked-eye magnitude ~6.5, enabling emission nebulae and galactic core imaging.
              </p>
            </div>
          </div>

          <!-- Optical Array & Hardware Manifest -->
          <div class="field-subcard">
            <div class="subcard-header">
              <span class="subcard-tag">HARDWARE ARSENAL</span>
              <h3 class="subcard-title">Club Telescope Array</h3>
            </div>
            <div class="gear-list">
              <div class="gear-item">
                <div class="gear-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                </div>
                <div class="gear-details">
                  <span class="gear-title">150mm (6") Newtonian Reflector</span>
                  <span class="gear-specs">f/5 Focal Ratio &bull; 750mm Focal Length &bull; Motorized Alt-Az GoTo</span>
                </div>
              </div>

              <div class="gear-item">
                <div class="gear-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
                    <line x1="4" y1="22" x2="4" y2="15" />
                  </svg>
                </div>
                <div class="gear-details">
                  <span class="gear-title">80mm ED Achromatic Refractor</span>
                  <span class="gear-specs">Dual-Speed Crayford Focuser &bull; Portable Expedition Scopes</span>
                </div>
              </div>

              <div class="gear-item">
                <div class="gear-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                  </svg>
                </div>
                <div class="gear-details">
                  <span class="gear-title">Planetary &amp; Deep-Sky Imaging Sensors</span>
                  <span class="gear-specs">ZWO High-Speed CMOS &bull; DSLR Prime Focus T-Rings &bull; O-III Narrowband Filters</span>
                </div>
              </div>
            </div>

            <div class="observer-checklist-box">
              <span class="checklist-title">EXPEDITION FIELD PROTOCOL:</span>
              <ul class="checklist-items">
                <li>Red-light torches only (&gt;620nm) to preserve 20-minute rhodopsin dark adaptation.</li>
                <li>30-minute primary mirror thermal equalization prior to critical collimation.</li>
                <li>Dew heaters activated 45 minutes prior to anticipated midnight saturation.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Article Section -->
    <section class="article-section" aria-labelledby="article-heading">
      <div class="article-card">
        <div class="article-badge">FEATURED DISPATCH // STARCAST JOURNAL</div>
        <h2 id="article-heading" class="article-title">The Callisto Ocean Dilemma: Magnetospheric Shielding on Jovian Ice Moons</h2>
        <div class="article-meta">
          <span>By Aether Wing Research Cohort</span>
          <span>&bull;</span>
          <span>Oct 2026 Edition</span>
          <span>&bull;</span>
          <span>8 min read</span>
        </div>
        <div class="article-prose">
          <p>
            While Europa commands mainstream astrobiological headlines for its eruptive plumes and chaotic ice terrain, its exterior neighbor Callisto offers an intriguing sanctuary. Lying outside Jupiter’s harsh inner radiation belts, Callisto undergoes far less magnetospheric sputtering.
          </p>
          <p>
            Galileo magnetometer flybys documented induced magnetic dipole fields that strongly indicate an electrically conductive, saline ocean residing 100 to 150 kilometers beneath its cratered lithosphere. In this dispatch, our astrophysics team contrasts inductive field attenuation data to model internal mantle conductivity...
          </p>
        </div>
        <div class="article-footer">
          <span class="full-article-note">Full scientific publication releasing in Callisto Journal Vol. IV</span>
        </div>
      </div>
    </section>

    <!-- Sub-Space Radio Transmission Section -->
    <section class="observatory-podcast-section" aria-label="Whispers of the Universe Sub-Space Radio">
      <PodcastTransmission client:load />
    </section>

    <!-- Join Content Team CTA -->
    <section class="content-cta-section" aria-label="Join StarCast Wing">
      <div class="cta-banner">
        <h3 class="cta-heading">Passionate About Science Writing & Astrophotography?</h3>
        <p class="cta-desc">
          StarCast Wing (Content & Editorial) is scouting science journalists, technical illustrators, and amateur astronomers to curate our weekly observatory dispatches.
        </p>
        <a href="/join" class="btn-primary">
          <span>Join the Editorial Crew</span>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .observatory-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-xs) var(--space-3xl);
    overflow-x: hidden;
    box-sizing: border-box;
  }

  @media (min-width: 480px) {
    .observatory-container {
      padding: var(--space-2xl) var(--space-md) var(--space-3xl);
    }
  }

  @media (min-width: 768px) {
    .observatory-container {
      padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    }
  }

  .observatory-header {
    margin-bottom: var(--space-2xl);
  }

  .nasa-section {
    margin-bottom: var(--space-3xl);
  }

  /* Section Card */
  .section-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-3xl);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--void) 70%, transparent);
  }

  @media (min-width: 768px) {
    .section-card {
      padding: var(--space-2xl);
    }
  }

  .card-meta-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--orbit);
    display: inline-block;
    margin-bottom: var(--space-xs);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .card-lead {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--steel);
    margin: 0 0 var(--space-xl) 0;
  }

  /* Targets Table */
  .targets-table-wrapper {
    overflow-x: auto;
  }

  .targets-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: left;
  }

  .targets-table th {
    color: var(--steel);
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
  }

  .targets-table td {
    padding: var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--steel) 15%, transparent);
    color: var(--star);
  }

  .target-name {
    color: var(--moon);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .target-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--astrophage);
    box-shadow: 0 0 6px var(--astrophage);
  }

  .target-mag {
    color: var(--orbit);
  }

  .target-time {
    color: var(--sol-dust);
  }

  /* Ground Station & Field Observing Manifest */
  .field-station-section {
    margin-bottom: var(--space-3xl);
  }

  .field-station-card {
    background: linear-gradient(145deg, rgba(15, 23, 42, 0.9), rgba(11, 17, 32, 0.95));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
  }

  @media (min-width: 768px) {
    .field-station-card {
      padding: var(--space-2xl);
    }
  }

  .field-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
  }

  .station-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--sol-dust);
    margin-bottom: var(--space-xs);
  }

  .field-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .field-subtitle {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--steel);
    max-width: 650px;
    margin: 0;
  }

  .station-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--orbit);
  }

  .status-indicator-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orbit);
    box-shadow: 0 0 8px var(--orbit);
  }

  .field-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .field-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field-subcard {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .subcard-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--orbit);
    letter-spacing: 0.1em;
  }

  .subcard-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0.2rem 0 0 0;
  }

  .seeing-table {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .seeing-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem;
    background: rgba(30, 41, 59, 0.5);
    border-radius: 6px;
    border-left: 3px solid var(--orbit);
  }

  .seeing-row.alt-site {
    border-left-color: #10b981;
  }

  .site-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .site-name {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--moon);
  }

  .site-loc {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--steel);
  }

  .bortle-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .bortle-urban {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #f59e0b;
  }

  .bortle-dark {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #10b981;
  }

  .bortle-class {
    font-size: 0.6875rem;
    font-weight: 800;
  }

  .bortle-desc {
    font-size: 0.58rem;
    opacity: 0.85;
  }

  .site-notes {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--starlight);
    margin: 0;
  }

  .gear-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gear-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.75rem;
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 6px;
  }

  .gear-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: rgba(56, 189, 248, 0.12);
    color: var(--orbit);
    flex-shrink: 0;
  }

  .gear-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .gear-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--moon);
  }

  .gear-specs {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--steel);
  }

  .observer-checklist-box {
    margin-top: 0.5rem;
    padding: 0.85rem;
    background: rgba(11, 17, 32, 0.8);
    border: 1px dashed rgba(56, 189, 248, 0.3);
    border-radius: 6px;
  }

  .checklist-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--sol-dust);
    letter-spacing: 0.08em;
  }

  .checklist-items {
    margin: 0.5rem 0 0 1.1rem;
    padding: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--starlight);
  }

  /* Featured Article Card */
  .article-section {
    margin-bottom: var(--space-3xl);
  }

  .article-card {
    background: linear-gradient(145deg, color-mix(in srgb, var(--navy) 60%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: 0 10px 32px color-mix(in srgb, var(--void) 80%, transparent);
  }

  @media (min-width: 768px) {
    .article-card {
      padding: var(--space-2xl);
    }
  }

  .article-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--sol-dust);
    margin-bottom: var(--space-xs);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--moon);
    margin: 0 0 var(--space-sm) 0;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--steel);
    margin-bottom: var(--space-lg);
  }

  .article-prose p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--star);
    margin-bottom: var(--space-md);
  }

  .article-footer {
    border-top: 1px solid color-mix(in srgb, var(--steel) 20%, transparent);
    padding-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--orbit);
  }

  /* APOD Section */
  .apod-section {
    margin-bottom: var(--space-3xl);
  }

  .apod-card {
    background-color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--steel) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .apod-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--star);
    margin-bottom: var(--space-xs);
  }

  .apod-title {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-lg) 0;
  }

  .apod-placeholder-canvas {
    background-color: color-mix(in srgb, var(--navy) 50%, var(--void));
    border: 1px dashed color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .apod-icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .apod-status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--astrophage);
  }

  .apod-note {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--steel);
    max-width: 540px;
    margin: 0;
  }

  /* Content CTA Banner */
  .content-cta-section {
    margin-top: var(--space-xl);
  }

  .cta-banner {
    background: linear-gradient(135deg, color-mix(in srgb, var(--dusk) 30%, var(--deep)), var(--deep));
    border: 1px solid color-mix(in srgb, var(--orbit) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--moon);
    margin: 0 0 var(--space-xs) 0;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
